[
  {
    "query": "Design a character creation screen that includes tabs for customization options and a preview widget to rotate the character.",
    "final_html": "<html>\n    <head>\n        <title>Character Creation Screen</title>\n    </head>\n    <body>\n        <header>\n            <h1>Character Creation</h1>\n        </header>\n        <nav>\n            <ul id=\"tabs\">\n                <li><a href=\"#customization\">Customization</a></li>\n                <li><a href=\"#appearance\">Appearance</a></li>\n                <li><a href=\"#skills\">Skills</a></li>\n                <li><a href=\"#backstory\">Backstory</a></li>\n            </ul>\n        </nav>\n        <main>\n            <section id=\"customization\">\n                <h2>Customization Options</h2>\n                <form>\n                    <label for=\"character-name\">Name:</label>\n                    <input type=\"text\" id=\"character-name\" name=\"character-name\" required />\n                    \n                    <fieldset>\n                        <legend>Gender</legend>\n                        <label><input type=\"radio\" name=\"gender\" value=\"male\" /> Male</label>\n                        <label><input type=\"radio\" name=\"gender\" value=\"female\" /> Female</label>\n                        <label><input type=\"radio\" name=\"gender\" value=\"non-binary\" /> Non-binary</label>\n                    </fieldset>\n\n                    <label for=\"class\">Class:</label>\n                    <select id=\"class\" name=\"class\">\n                        <option value=\"warrior\">Warrior</option>\n                        <option value=\"mage\">Mage</option>\n                        <option value=\"rogue\">Rogue</option>\n                    </select>\n\n                    <button type=\"submit\">Save Changes</button>\n                </form>\n            </section>\n            <section id=\"appearance\">\n                <h2>Character Appearance</h2>\n                <img src=\"https://images.unsplash.com/photo-1617289755070-3590b660a06e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3NTgzNjR8MHwxfHNlYXJjaHwxfHxjaGFyYWN0ZXIlMjBjdXN0b21pemF0aW9uJTIwb3B0aW9uc3xlbnwwfHx8fDE3NDg3MTA4ODJ8MA&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"character customization options\" style=\"width:100%; max-width:500px;\" />\n                <label for=\"skin-tone\">Skin Tone:</label>\n                <input type=\"color\" id=\"skin-tone\" name=\"skin-tone\" />\n                \n                <label for=\"hair-style\">Hair Style:</label>\n                <select id=\"hair-style\" name=\"hair-style\">\n                    <option value=\"long\">Long</option>\n                    <option value=\"short\">Short</option>\n                    <option value=\"bald\">Bald</option>\n                </select>\n                \n                <label for=\"eye-color\">Eye Color:</label>\n                <input type=\"color\" id=\"eye-color\" name=\"eye-color\" />\n            </section>\n            <section id=\"skills\">\n                <h2>Skills</h2>\n                <label for=\"skill-points\">Skill Points:</label>\n                <input type=\"number\" id=\"skill-points\" name=\"skill-points\" min=\"0\" max=\"100\" />\n                \n                <label for=\"skills-list\">Select Skills:</label>\n                <select id=\"skills-list\" name=\"skills\" multiple>\n                    <option value=\"swordsmanship\">Swordsmanship</option>\n                    <option value=\"archery\">Archery</option>\n                    <option value=\"alchemy\">Alchemy</option>\n                </select>\n            </section>\n            <section id=\"backstory\">\n                <h2>Character Backstory</h2>\n                <textarea id=\"backstory-text\" name=\"backstory-text\" rows=\"4\" cols=\"50\" placeholder=\"Write your character's backstory here...\"></textarea>\n            </section>\n            <aside id=\"preview-widget\">\n                <h2>Character Preview</h2>\n                <div id=\"preview-area\">\n                    <img src=\"https://images.unsplash.com/photo-1635003913011-95971abba560?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3NTgzNjR8MHwxfHNlYXJjaHwxfHwzRCUyMGNoYXJhY3RlciUyMG1vZGVsfGVufDB8fHx8MTc0ODcxMDg4M3ww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"3D character model\" style=\"width:100%; max-width:400px;\" />\n                </div>\n                <button id=\"rotate-character\">Rotate Character</button>\n            </aside>\n        </main>\n    </body>\n</html>",
    "keywords": {
      "1": "character customization options",
      "2": "3D character model"
    }
  }
]