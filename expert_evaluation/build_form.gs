{"files":[{"id":"3712c6be-fe37-42e4-9d54-5fd3253711b0","name":"appsscript","type":"json","source":"{\n  \"timeZone\": \"Asia/Seoul\",\n  \"dependencies\": {\n  },\n  \"exceptionLogging\": \"STACKDRIVER\",\n  \"runtimeVersion\": \"V8\"\n}"},{"id":"6300f308-8339-45e7-950b-32177e934b39","name":"Code","type":"server_js","source":"/***************** [ 사용자 상수 ] *****************/\nconst CSV_FILE_ID \u003d \u002711GRaFPYVcEAubCkSZyNTU2NV2wy2duHq\u0027; // ← 목록 CSV\n\nconst CSV_COL     \u003d 2;                             // 0·1·2 중 선택\nconst IMG_ROOT_ID \u003d \u0027108miEwuJ76P0hwtlMxM-F4pUbQXKtZcj\u0027;\nconst TXT_ROOT_ID \u003d \u00271kOqayiUNO0FWdOFbGr7pN68Ut4T2UeXp\u0027;\n\nconst SUB_FOLDERS \u003d [\n  \u0027final_qwen7b_screenshots\u0027,\n  \u0027qwen14b_screenshots\u0027,\n  \u0027designer1_target_screenshots\u0027\n];\nconst ROW_LABELS \u003d [\u0027Image 1\u0027,\u0027Image 2\u0027,\u0027Image 3\u0027];\nconst RANK_COLS  \u003d [\u00271\u0027,\u00272\u0027,\u00273\u0027];\n\n/************ 1. 100개 빌드 시작 ************/\nfunction startBuild() {\n  const props \u003d PropertiesService.getScriptProperties();\n  props.deleteAllProperties();          // logSheetId 유지하고 싶으면 삭제 X\n  props.setProperty(\u0027idx\u0027,\u00270\u0027);\n  logProgress(\u0027🔄 startBuild() – 새 폼 100개 생성 시작\u0027, 0);\n  buildSafely();\n}\n\n/************ 2. 안전 실행 (타임 세이프) ************/\nfunction buildSafely() {\n  const MAX_MS \u003d 330000;                // 5분 30초\n  const t0     \u003d Date.now();\n  const props  \u003d PropertiesService.getScriptProperties();\n\n  let idx \u003d Number(props.getProperty(\u0027idx\u0027) || \u00270\u0027);\n  logProgress(\u0027▶ buildSafely 다시 시작\u0027, idx);\n\n  /* A. 메타 캐시 */\n  let meta \u003d props.getProperty(\u0027meta\u0027);\n  if (!meta) {\n    logProgress(\u0027📥 Drive \u0026 CSV 스캔…\u0027, idx);\n    meta \u003d JSON.stringify(scanOnce_());\n    props.setProperty(\u0027meta\u0027, meta);\n    logProgress(\u0027📥 스캔 완료·메타 저장\u0027, idx);\n  }\n  const { imgMaps, baseArr, txtMap, formId } \u003d JSON.parse(meta);\n  const form \u003d FormApp.openById(formId);\n\n  /* B. 페이지 루프 */\n  while (idx \u003c baseArr.length) {\n    if (Date.now() - t0 \u003e MAX_MS) break;   // 타임아웃 방지\n\n    const baseFull   \u003d baseArr[idx];                 // airbnb_screenshot\n    const baseSimple \u003d baseFull.replace(/_screenshot$/,\u0027\u0027);\n\n    if (idx) form.addPageBreakItem().setTitle(`Set ${idx+1}/100`);\n    form.addSectionHeaderItem().setTitle(baseSimple);\n    logProgress(`▶ Page ${idx+1}/100 – ${baseFull}`, idx);\n\n    /* 이미지 3장 */\n    imgMaps.forEach((map, k) \u003d\u003e {\n      const fid \u003d map[baseFull];\n      if (!fid) { logProgress(`⚠️ 이미지 없음 (${ROW_LABELS[k]})`, idx); return; }\n      form.addImageItem()\n          .setTitle(ROW_LABELS[k])\n          .setImage(DriveApp.getFileById(fid).getBlob());\n    });\n\n    /* 통합 그리드 질문 */\n    form.addGridItem()\n        .setTitle(txtMap[baseSimple] || \u0027\u0027)\n        .setRows(ROW_LABELS)\n        .setColumns(RANK_COLS)\n        .setValidation(\n          FormApp.createGridValidation()\n                .requireLimitOneResponsePerColumn()\n                .build())\n        .setHelpText(\u0027각 행에 1·2·3 순위를 한 번씩 선택\u0027)\n        .setRequired(true);\n\n    logProgress(`✅ Page ${idx+1} 완료`, idx);\n    idx++;\n  }\n\n  /* C. 저장 또는 종료 */\n  if (idx \u003c baseArr.length) {\n    props.setProperty(\u0027idx\u0027, String(idx));\n    ScriptApp.newTrigger(\u0027buildSafely\u0027)\n             .timeBased().after(60*1000).create();\n    logProgress(`⏳ 중단 → idx\u003d${idx} 저장, 1분 뒤 재개`, idx);\n  } else {\n    props.deleteAllProperties();\n    logProgress(\u0027🎉 100개 폼 생성 완료\u0027, 100);\n  }\n}\n\n/************ 3. 최초 한 번만 스캔 ************/\nfunction scanOnce_() {\n\n  /* ★ 3-1. CSV에서 100개 목록 추출 + \"_screenshot\" 붙이기 */\n  const csvText \u003d DriveApp.getFileById(CSV_FILE_ID)\n                   .getBlob().getDataAsString();\n  const lines \u003d csvText.split(/\\r?\\n/).filter(l \u003d\u003e l.trim());\n  const baseArr \u003d lines\n    .map(r \u003d\u003e r.split(\u0027,\u0027)[CSV_COL]?.trim())\n    .filter(x \u003d\u003e x)                       // 빈 셀 제거\n    .map(name \u003d\u003e name + \u0027_screenshot\u0027);   // ★ 접미어 부착\n\n  if (baseArr.length !\u003d\u003d 100)\n    throw new Error(\u0027CSV 열 \u0027 + (CSV_COL+1) +\n                    \u0027 실제 개수 \u003d \u0027 + baseArr.length + \u0027 (100 필요)\u0027);\n\n  /* 3-2. 이미지 ID 매핑 */\n  const root \u003d DriveApp.getFolderById(IMG_ROOT_ID);\n  const imgMaps \u003d SUB_FOLDERS.map(name \u003d\u003e {\n    const m \u003d {}, it \u003d root.getFoldersByName(name).next().getFiles();\n    while (it.hasNext()) {\n      const f    \u003d it.next();\n      const key  \u003d f.getName().replace(/\\.(png|jpe?g)$/i,\u0027\u0027); // key \u003d xxx_screenshot\n      m[key]     \u003d f.getId();\n    }\n    return m;\n  });\n\n  /* 3-3. TXT 본문 맵 */\n  const txtMap \u003d {};\n  const itTxt  \u003d DriveApp.getFolderById(TXT_ROOT_ID).getFiles();\n  while (itTxt.hasNext()) {\n    const f   \u003d itTxt.next();\n    txtMap[f.getName().replace(/\\.txt$/i,\u0027\u0027)]\n         \u003d f.getBlob().getDataAsString().trim();\n  }\n\n  /* 3-4. 새 폼 생성 */\n  const title  \u003d `Expert Evaluation – CSV col ${CSV_COL+1}`;\n  const formId \u003d FormApp.create(title).getId();\n  logProgress(`📄 새 폼 생성: ${title}`, 0);\n\n  return { imgMaps, baseArr, txtMap, formId };\n}\n\n/************ 4. 스프레드시트 로깅 ************/\nfunction getLogSheet() {\n  const props \u003d PropertiesService.getScriptProperties();\n  let id \u003d props.getProperty(\u0027logSheetId\u0027);\n  if (id) return SpreadsheetApp.openById(id).getSheets()[0];\n  const ss \u003d SpreadsheetApp.create(\u0027Build Progress Log (100-set)\u0027);\n  const sh \u003d ss.getSheets()[0];\n  sh.appendRow([\u0027Timestamp\u0027,\u0027Idx\u0027,\u0027Message\u0027]);\n  props.setProperty(\u0027logSheetId\u0027, ss.getId());\n  return sh;\n}\nfunction logProgress(msg, idx) {\n  getLogSheet().appendRow([new Date(), idx, msg]);\n}\n\n/************ 5. 캐시 초기화(원할 때) ************/\nfunction clearAll() {\n  PropertiesService.getScriptProperties().deleteAllProperties();\n  Logger.log(\u0027🗑️ 모든 프로퍼티 초기화 완료\u0027);\n}\n"}]}